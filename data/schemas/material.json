{
  "$defs": {
    "EvidenceQuality": {
      "enum": [
        "confirmed",
        "inferred",
        "incomplete",
        "conflicting"
      ],
      "title": "EvidenceQuality",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Material identity aligned with the USGS 2025 critical-minerals table.",
  "properties": {
    "source_name": {
      "minLength": 1,
      "title": "Source Name",
      "type": "string"
    },
    "source_url": {
      "anyOf": [
        {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Url"
    },
    "source_record_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Record Id"
    },
    "retrieved_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retrieved Date"
    },
    "generated_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generated Date"
    },
    "license_or_reuse_status": {
      "minLength": 1,
      "title": "License Or Reuse Status",
      "type": "string"
    },
    "evidence_quality": {
      "$ref": "#/$defs/EvidenceQuality"
    },
    "is_synthetic": {
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "material_id": {
      "minLength": 1,
      "title": "Material Id",
      "type": "string"
    },
    "material_name": {
      "minLength": 1,
      "title": "Material Name",
      "type": "string"
    },
    "material_category": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Material Category"
    },
    "is_rare_earth_element": {
      "default": false,
      "title": "Is Rare Earth Element",
      "type": "boolean"
    },
    "criticality_reference": {
      "minLength": 1,
      "title": "Criticality Reference",
      "type": "string"
    },
    "publication_year": {
      "title": "Publication Year",
      "type": "integer"
    },
    "sort_order": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sort Order"
    }
  },
  "required": [
    "source_name",
    "license_or_reuse_status",
    "evidence_quality",
    "is_synthetic",
    "material_id",
    "material_name",
    "criticality_reference",
    "publication_year"
  ],
  "title": "Material",
  "type": "object"
}
